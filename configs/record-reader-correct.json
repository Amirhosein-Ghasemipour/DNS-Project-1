      "expected": {
        "exit_code": 0,
        "stdout": "1234567890123456",
        "stderr": "",
        "reference": "targets/CONTRACTS.md: independent record/API contract"
      }
    },
    {
      "id": "empty",
      "category": "boundary",
      "input": "targets/record_reader/inputs/empty.bin",
      "expected": {
