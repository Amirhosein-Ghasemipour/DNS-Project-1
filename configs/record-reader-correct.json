      "input": "targets/record_reader/inputs/original.bin",
      "expected": {
        "exit_code": 2,
        "stdout": "too long\n",
        "stderr": "",
        "reference": "targets/CONTRACTS.md: independent record/API contract"
      },
      "minimized_expected": {
        "exit_code": 2,
        "stdout": "too long\n",
        "stderr": "",
