{
  "schema_version": 1,
  "name": "record-reader/correct",
  "target": "record_reader",
  "root": "..",
  "authorized": true,
  "versions": {
    "baseline": {
      "repository": "targets/record_reader/repository",
      "revision": "7e95fc401f516c0bf9e52ca5f4b56fcbd8b7c5b6"
    },
    "patched": {
      "repository": "targets/record_reader/repository",
      "revision": "516a416490b741512bd362eb142a185c22066e69"
    }
  },
  "builds": {
    "release": {
      "commands": [
        [
          "cc",
          "-std=c11",
          "-g",
          "-O2",
          "-fstack-protector-strong",
          "-fPIE",
          "-pie",
          "-Wl,-z,relro,-z,now",
          "-Wl,-z,noexecstack",
          "/work/reader.c",
          "-o",
          "target"
        ]
      ],
      "binary": "target"
    },
    "sanitized": {
      "commands": [
        [
          "cc",
          "-std=c11",
          "-g",
          "-O1",
          "-fno-omit-frame-pointer",
          "-fno-pie",
          "-no-pie",
          "-fsanitize=address,undefined",
          "-fno-sanitize-recover=all",
          "/work/reader.c",
          "-o",
          "target"
        ]
      ],
      "binary": "target",
      "env": {
        "ASAN_OPTIONS": "detect_leaks=0:halt_on_error=1:symbolize=1:allow_addr2line=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      }
    }
  },
  "execution": {
    "interface": "stdin",
    "argv": [
      "{binary}"
    ]
  },
  "tests": [
    {
      "id": "valid",
      "category": "valid",
      "input": "targets/record_reader/inputs/valid.bin",
      "expected": {
        "exit_code": 0,
        "stdout": "hello",
        "stderr": "",
        "reference": "targets/CONTRACTS.md: independent record/API contract"
      }
    },
    {
